{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "RateLimits": {
    "CaptchaPerMinute": 30,
    "CommentsPerMinute": 10
  }
}
