{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "Provider": "Disk",
    "RootPath": "uploads"
  },
  "RateLimits": {
    "CaptchaPerMinute": 30,
    "CommentsPerMinute": 10,
    "PreviewPerMinute": 60
  }
}
